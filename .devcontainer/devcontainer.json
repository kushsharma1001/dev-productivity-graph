{
  "name": "Developer Productivity Graph",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven",
        "vmware.vscode-boot-dev-pack"
      ]
    }
  },
  "postCreateCommand": "chmod +x mvnw && ./mvnw clean install"
}
